{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myverse-ai-api",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // Locally selected namespace; verify it is unused in the account before deployment.
      "namespace_id": "41001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "vars": { "AI_ENABLED": "false", "LOCAL_DEV_ORIGINS": "" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": { "enabled": false },
    "issues": { "enabled": false }
  }
}
