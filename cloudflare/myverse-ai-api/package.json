{
  "name": "myverse-ai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "dev:remote-ai": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:acceptance": "node --test bench/acceptance-persistence.test.mjs",
    "acceptance:run": "node --experimental-strip-types bench/phase-4b2a4-live-validation.mjs run",
    "validate": "wrangler types --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.158.0"
  }
}
